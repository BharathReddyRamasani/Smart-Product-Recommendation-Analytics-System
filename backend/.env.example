MONGODB_URL=mongodb://localhost:27017
DB_NAME=recommendation_db

SECRET_KEY=change-this-secret-key-in-production-make-it-long
APP_ENV=development
LOG_LEVEL=INFO

# Use * to allow all origins (for Render/production deployments)
# Or restrict to specific origins: http://localhost:3000,https://your-frontend.onrender.com
CORS_ORIGINS=*

TOP_K_DEFAULT=10
SEED_ON_STARTUP=true
